							<h3>検索結果</h3>

							<form method="post" action="http://www.novels.jp/~yaji/blog/mt-search.cgi">

							<h3>サイトを検索: </h3>

							<p><input type="text" size="30" name="search" value="" /> <input type="submit" value="検索" /></p>

