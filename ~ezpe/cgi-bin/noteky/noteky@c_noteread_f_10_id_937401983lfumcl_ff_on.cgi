<table border="0" width="100%">
<tr>
<td  bgcolor="#00FFCC"><strong><a href="http://www14.big.or.jp/~yays/gallery/art17.html" target="_blank">八重洲一成</a></strong>  <i>1999/09/15 22:26:23</i><br></td>
<td bgcolor="#00CCFF" width="10%" align="center" nowrap>
