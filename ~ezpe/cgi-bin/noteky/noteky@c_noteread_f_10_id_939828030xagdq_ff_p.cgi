<font size="+2" color="#0000FF">彼と彼女と聖剣と私</font><br>
<hr>
<table border="0" width="100%">
<tr>
<td  bgcolor="#00FFCC"><strong>webmaster</strong>  <i>1999/10/14 00:20:28</i><br></td>
