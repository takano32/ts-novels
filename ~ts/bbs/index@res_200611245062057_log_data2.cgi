<TABLE><TR><TD bgcolor=#114422><font size=+1 color="#aaaaaa">[522]</font> <font size=4 color=#40c0c0> 第2掲示板ですが</font></TD><TD></td></Tr></TABLE>
</td></table>
<table border=0 cellpadding=1 cellspacing=0 width=100%><td nowrap>
<font size=-1 color=#606060> 2006/11/24 (金) 06:20:57  ひのひと </font></td>
<td nowrap align=left><font size=3>　<a href="index.cgi?res=200611245062057&log=data2">返信</a>　削除<input type=checkbox name="target" value="200611245062057"></font>
