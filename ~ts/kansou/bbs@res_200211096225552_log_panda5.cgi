<td nowrap align=right><font size=3>　<a href="bbs@res_200212150133832_log_panda5.cgi">返信</a>　削除<input type=checkbox name="target" value="200212150133832"></font>
</td></table>
<table border=0 cellpadding=16 cellspacing=0 width=100%><td>
