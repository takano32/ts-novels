</td></table>
<table border=0 cellpadding=1 cellspacing=0 width=100%><td nowrap>
<font size=3 color=#606060><strong>▽</strong> 2013/03/14 (木) 23:42:23 <strong>▽</strong> ほたる </font></td>
<td nowrap align=right><font size=3>　<a href="bbs@res_201303144234223_log_delayed.cgi">返信</a>　削除<input type=checkbox name="target" value="201303144234223"></font>
</td></table>
<table border=0 cellpadding=16 cellspacing=0 width=100%><td>
