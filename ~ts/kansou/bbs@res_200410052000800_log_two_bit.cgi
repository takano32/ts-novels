<hr size=1 noshade width=95%>

<table border=0 cellpadding=0 cellspacing=0 width=95%><tr><td><table border=0 cellpadding=1 cellspacing=0 width=100%><td>
<font size=2>[11]</font> <font size=4 color=#40c0c0> ヨミマシタ</font>
</td></table>
<table border=0 cellpadding=1 cellspacing=0 width=100%><td nowrap>
<font size=3 color=#606060><strong>▽</strong> 2004/09/18 (土) 12:03:13 <strong>▽</strong> メガ\ </font></td>
<td nowrap align=right><font size=3>　<a href="bbs@res_200409186120313_log_two_bit.cgi">返信</a>　削除<input type=checkbox name="target" value="200409186120313"></font>
</td></table>
<table border=0 cellpadding=16 cellspacing=0 width=100%><td>
