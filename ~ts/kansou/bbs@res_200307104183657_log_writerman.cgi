<table border=0 cellpadding=0 cellspacing=0 width=95%><tr><td><table border=0 cellpadding=1 cellspacing=0 width=100%><td>
<font size=2>[117]</font> <font size=4 color=#40c0c0> 第３話読みました</font>
</td></table>
<table border=0 cellpadding=1 cellspacing=0 width=100%><td nowrap>
<font size=3 color=#606060><strong>▽</strong> 2003/08/10 (日) 10:27:29 <strong>▽</strong> SORA </font></td>
<td nowrap align=right><font size=3>　<a href="bbs.cgi?res=200308100102729&log=writerman">返信</a>　削除<input type=checkbox name="target" value="200308100102729"></font>
