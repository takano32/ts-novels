<td nowrap align=right><font size=3>　<a href="bbs@res_200401132143258_log_nhk.cgi">返信</a>　削除<input type=checkbox name="target" value="200401132143258"></font>
</td></table>
<table border=0 cellpadding=16 cellspacing=0 width=100%><td>
