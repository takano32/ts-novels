pre<input type=checkbox name="pre" value="1"> 
link<input type=checkbox name="link" value="1" checked> 
削除キー <input type=password name="pwd" size=10 value=""> 入力コード Qxn9C4  <input type=password name="rcode" size=10 value=""> <input type=hidden name="hrcode" size=10 value="Qxn9C4"> <input type=submit value="書き込む"><input type=reset value="書き直し"><br></td></tr></table>
</td></tr></table><br>
</form>
