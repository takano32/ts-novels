<td nowrap align=left><font size=3>　<a href="bbs.cgi?res=200301223225929&log=mondo">返信</a>　削除<input type=checkbox name="target" value="200301223225929"></font>
</td></table>
<table border=0 cellpadding=16 cellspacing=0 width=100%><td>
