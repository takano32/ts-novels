<td nowrap align=left><font size=3>　<a href="bbs.cgi?res=200303230002519&log=kayo_chan">返信</a>　削除<input type=checkbox name="target" value="200303230002519"></font>
</td></table>
<table border=0 cellpadding=16 cellspacing=0 width=100%><td>
